   "extras": {
    "sl_authored": true,
    "sl_authored_provenance": "64x64 gold environment matcap authored by the project owner with the owner's own tooling: a lit sphere rendered from a procedural studio environment - neutral sky, warm floor, hard horizon and three area lights - with the view vector reflected off a per-texel sphere normal, and a gold Fresnel response held tinted at grazing angles rather than rising to white. Not resampled from, traced from, or derived from any ROM texture."
   }
  },
