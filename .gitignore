### Sightline ###

# Python venv. Never committed; recreate with: make venv
.venv/

# The user-supplied base ROM. NEVER COMMIT THIS.
# *.[zZnN]64 above already covers it; this is deliberately redundant so the rule
# survives an upstream rebase that touches the pattern above.
baserom*.z64
baserom*.n64
baserom*.v64

# Sightline build output
/build/
tools/sightline/__pycache__/
tools/trace/__pycache__/
tools/derive/__pycache__/

# IDO static recomp build products (tools/ido5.3_recomp/.gitignore covers the
# binaries themselves; these are the intermediates it does not list)
tools/ido5.3_recomp/*.o
tools/ido5.3_recomp/rabbitizer/build/

# CI runner state. act_runner writes its registration credential to
# ci/runner/data/.runner - that is a secret and must never be committed.
ci/runner/data/
ci/runner/.env
.venv-ci/

# Compiled trace-harness input plugin (built by its Makefile / CI)
tools/trace/slinput/*.so
# Savestates hold ROM-derived RAM - local only, never committed
tools/trace/states/

# Host-mode CI runner: binary is extracted from the image, credential is secret
ci/runner-host/act_runner
ci/runner-host/.runner

# Third-party reference material: cheat databases, community notes, etc.
# Useful locally, not ours to redistribute, and project policy keeps external
# reference outside the repo (cf. Zoinkity's notes, cloned separately).
reference/

# The LIVE cartridge save - your progress, and it moves every session.
tools/trace/saves/
# NOTE: tools/trace/inputs/*.eeprom is deliberately NOT ignored. Those are the
# per-recording snapshots of the cartridge as a session started, and replay
# cannot reproduce a trace without one - ignoring them would leave committed
# traces unverifiable from a fresh clone or on CI. They are almost entirely
# zeros and compress to well under a kilobyte each.

# Recordings kept for reference but not usable (ROM gone, or made with a bug)
tools/trace/quarantine/
build/u/direct/*.build
build/native/

# Per-session working files
build/.keep-going-count
build/bootsweep/

# ROM-derived framebuffer captures (SL_SHOT) - never commit
*.ppm

# package-demo.ps1 output: carries the user's ROM, private and local
SightlineDemo.exe

# Texture sets (#47). Exactly the baserom boundary above, one level out: the
# user brings the SOURCE, a local tool writes the PACK, and neither is ours to
# distribute. Nothing under either directory is ever committed, packaged or
# exported.
#
#   texsources/   the player's own copies of a texture set's source - the
#                 Community HD project's official release archive, and any
#                 user-supplied XBLA source. Read only by
#                 tools/windows/prepare-textures.ps1.
#   texpacks/     what that tool WRITES: <set>/<hex4>.sltx, the development
#                 SL_TEXPACK_ROOT. Derived from the sources above, so it
#                 inherits their boundary exactly.
/texsources/
/texpacks/
